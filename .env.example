# OPTIONAL. `docker compose up` needs no .env: the first boot generates the
# install's secrets into the osds-secrets volume. Copy this file to .env only to
# override something. Every line below is commented out on purpose.

# Where the first-run wizard and the operator console are served. A hostname,
# no port. Must be the name you browse to; tenant directories use other names.
# OSDS_CONSOLE_HOST=localhost

# The compose default is false because a fresh install is plain HTTP. Set true
# once TLS is terminating in front of the app.
# OSDS_SECURE_COOKIES=false

# Reverse proxies allowed to tell the app who the client is (X-Forwarded-For).
# Addresses or CIDRs, comma-separated. Leave empty unless a proxy sits in front
# of the app; set it, or every visitor is rate-limited as one client.
# OSDS_TRUSTED_PROXIES=

# Let the webhook adapter POST to a PRIVATE address (10.x, 172.16-31.x, 192.168.x,
# fc00::/7) and use plain HTTP to one -- an n8n or similar on your own network.
# Off by default. Loopback and the cloud metadata address (169.254.169.254) are
# never reachable, whatever this says.
# OSDS_WEBHOOK_ALLOW_PRIVATE=false

# Host port for the app.
# OSDS_PORT=8000
# GUNICORN_WORKERS=3

# Supply your own secrets or database instead of the generated ones. A value
# set here wins over the generated file.
#
# WARNING: OSDS_SECRET_KEY encrypts the credentials stored through the wizard
# (SMTP password, storage keys). Changing it, or losing the osds-secrets volume
# that holds the generated one, makes those credentials unrecoverable.
# DJANGO_SECRET_KEY=
# OSDS_SECRET_KEY=
# DATABASE_URL=postgresql://osds_app:...@db.example.com:5432/osds
# DATABASE_URL_ADMIN=postgresql://osds:...@db.example.com:5432/osds

# --- Running outside Docker (development) -----------------------------------
# manage.py does not read .env; export these in your shell.
# DJANGO_SECRET_KEY=dev-only-change-me
# OSDS_SECRET_KEY=dev-only-change-me-too
# DJANGO_DEBUG=1
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/osds_dev
# OSDS_CONSOLE_HOST=console.localhost
# OSDS_DEV_TENANT_SLUG=chicago-plumbers
