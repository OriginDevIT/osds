{
  "name": "osds",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "docker compose up -d && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --build --force",
    "migrate:dev": "pnpm --filter @osds/db migrate",
    "db:codegen": "pnpm --filter @osds/db codegen",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "prettier": "^3.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
