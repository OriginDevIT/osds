{
  "name": "@osds/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "migrate": "tsx src/migrate.ts",
    "codegen": "kysely-codegen --dialect postgres --out-file src/schema.ts"
  },
  "dependencies": {
    "kysely": "^0.27.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.11.10",
    "kysely-codegen": "^0.17.0",
    "tsx": "^4.19.2"
  }
}
